# =============================================================================
# Secrets
# =============================================================================
.env
.env.local
secrets/
secrets.json
*.pem
*.key

# =============================================================================
# Runs — one directory per model run (see prospects/config.RunPaths)
# =============================================================================
# Keep code and the small published evaluation packet in git; keep the heavy
# regeneratable binaries (models, panels, longs, scored, scratch) out.
runs/**/models/
runs/**/training/
runs/**/scored/
runs/**/scratch/
runs/**/logs/
runs/**/buy_lists/
# ...but DO track each run's evaluation packet (CSVs + README + headline.json).
!runs/**/evaluation/
!runs/**/evaluation/**

# =============================================================================
# Archive — superseded runs, DB backups, retired artifacts (local only)
# =============================================================================
archive/

# =============================================================================
# Databases (live + modeling; regenerated from ingestion)
# =============================================================================
*.db
*.db.bak*
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# =============================================================================
# Reference inputs — hand-curated, checked in
# =============================================================================
# reference/ is tracked, but keep its bulk regeneration workspaces out of git.
reference/**/milb_season_stats.csv
# FanGraphs scouting: track the built inputs the model reads; ignore the
# 85MB scrape/parse workspace that regenerates them.
reference/fangraphs_board/raw/
reference/fangraphs_board/parsed/
reference/fangraphs_board/chadwick_register.csv

# =============================================================================
# Legacy top-level artifact dirs (pre-runs/ layout; kept ignored so stray
# regenerated files never re-enter git)
# =============================================================================
models/*.pkl
models/*.joblib
models/*.npz
!models/*.txt
panel_*.npz
panel_*.joined.pkl
panels/
results/
scratch/
outputs/
logs/
db_dump/
mnt/
backtests/*.csv
buy_list_*.csv
snap*_long.csv
*_pids.txt

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.coverage
htmlcov/
venv/
.venv/
env/

# =============================================================================
# Logs / editor / OS
# =============================================================================
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
.claude/
.cursor/
