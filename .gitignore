# =============================================================================
# Secrets
# =============================================================================
.env
.env.local
secrets/
secrets.json
*.pem
*.key

# =============================================================================
# Runs — one directory per model run (see prospects/config.RunPaths)
# =============================================================================
# Keep code and the small published evaluation packet in git; keep the heavy
# regeneratable binaries (models, panels, longs, scored, scratch) out.
runs/**/models/
runs/**/training/
runs/**/scored/
runs/**/scratch/
runs/**/logs/
runs/**/buy_lists/
# ...but DO track each run's evaluation packet (CSVs + README + headline.json).
!runs/**/evaluation/
!runs/**/evaluation/**

# =============================================================================
# Archive — superseded runs, DB backups, retired artifacts (local only)
# =============================================================================
archive/

# =============================================================================
# Databases (live + modeling; regenerated from ingestion)
# =============================================================================
*.db
*.db.bak*
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# =============================================================================
# Generated data outputs — regenerated by `prospects-pull`; heavy, keep out of
# git. The model reads prospects.db (ignored above), not these; they are tee
# sidecars / audit artifacts. Hand-curated inputs (holdings.csv, card_*.csv)
# stay tracked.
# =============================================================================
/milb_season_stats.csv
/mlb_season_stats.csv
/draft_align_audit.csv

# =============================================================================
# Reference inputs — hand-curated, checked in
# =============================================================================
# reference/ is tracked, but keep its bulk regeneration workspaces out of git.
reference/**/milb_season_stats.csv
# FanGraphs scouting: the raw board HTML is a point-in-time scrape of boards
# that are NOT retrievable for past years — it is source data, not a workspace,
# so it is tracked despite the size. parsed/ + chadwick_register are cheap and
# tracked alongside it so a fresh clone can rebuild the grades without scraping.

# =============================================================================
# Legacy top-level artifact dirs (pre-runs/ layout; kept ignored so stray
# regenerated files never re-enter git)
# =============================================================================
models/*.pkl
models/*.joblib
models/*.npz
!models/*.txt
panel_*.npz
panel_*.joined.pkl
panels/
results/
scratch/
outputs/
logs/
db_dump/
mnt/
backtests/*.csv
buy_list_*.csv
snap*_long.csv
*_pids.txt

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.coverage
htmlcov/
venv/
.venv/
env/

# =============================================================================
# Logs / editor / OS
# =============================================================================
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
.claude/
.cursor/

# FanGraphs scrape debug dumps (debris, not source)
reference/fangraphs_board/raw/**/debug_*.json
